@model GymBoom.Models.Product
@{
    ViewData["Title"] = "Ürün Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card gym-card">
                <div class="card-header bg-dark border-bottom border-secondary pb-0">
                    <h4 class="text-light mt-2">✏️ Ürün Düzenle: @Model.Name</h4>
                </div>
                <div class="card-body gym-card-inner">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        
                        <input type="hidden" asp-for="ImageUrl" /> 

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label text-light fw-semibold">Ürün Adı</label>
                            <input asp-for="Name" class="form-control bg-dark text-light border-secondary" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="CategoryId" class="form-label text-light fw-semibold">Kategori</label>
                                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select bg-dark text-light border-secondary" required>
                                    <option value="">-- Kategori Seçin --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Price" class="form-label text-light fw-semibold">Fiyat (₺)</label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control bg-dark text-light border-secondary" required />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Stock" class="form-label text-light fw-semibold">Stok Adedi</label>
                                <input asp-for="Stock" type="number" class="form-control bg-dark text-light border-secondary" required />
                                <span asp-validation-for="Stock" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label text-light fw-semibold">Ürün Açıklaması</label>
                            <textarea asp-for="Description" class="form-control bg-dark text-light border-secondary" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-light fw-semibold">Yeni Görsel Yükle (İsteğe Bağlı)</label>
                            
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="d-flex align-items-center mb-2 p-2 rounded border border-secondary border-opacity-25 bg-dark">
                                    <img src="~/StoreImages/@Model.ImageUrl" alt="Mevcut Görsel" style="width: 50px; height: 50px; object-fit: cover;" class="rounded me-3" />
                                    <span class="text-secondary small">Mevcut görseli değiştirmek isterseniz aşağıdan yeni bir dosya seçin. Seçmezseniz bu görsel korunur.</span>
                                </div>
                            }
                            
                            <input type="file" name="imageFile" class="form-control bg-dark text-light border-secondary" accept="image/*" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                            <button type="submit" class="btn btn-warning fw-bold px-4 text-dark">Değişiklikleri Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>