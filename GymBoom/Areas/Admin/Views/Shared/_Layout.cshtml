<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymBoom Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        .admin-sidebar { min-height: 100vh; width: 260px; background-color: #161b22; border-right: 1px solid #30363d; }
        .admin-content { background-color: #0d1117; flex-grow: 1; }
        .nav-link { color: #8b949e; margin-bottom: 0.5rem; border-radius: 0.375rem; }
        .nav-link:hover, .nav-link.active { background-color: #21262d; color: #fff; }
    </style>
</head>
<body class="d-flex">

    <div class="admin-sidebar p-3 d-flex flex-column">
        <a href="/" class="d-flex align-items-center mb-4 text-white text-decoration-none">
            <span class="fs-4 fw-bold text-danger"><i class="bi bi-lightning-charge-fill me-2"></i>GymBoom</span>
        </a>
        <hr class="border-secondary opacity-25">
        <ul class="nav nav-pills flex-column mb-auto mt-2">
            <li class="nav-item">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link active">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
            </li>
            <li>
                <a href="#" class="nav-link">
                    <i class="bi bi-box-seam me-2"></i> Ürün Yönetimi
                </a>
            </li>
            <li>
                <a href="#" class="nav-link">
                    <i class="bi bi-card-checklist me-2"></i> Siparişler
                </a>
            </li>
            <li>
                <a href="#" class="nav-link">
                    <i class="bi bi-people me-2"></i> Üyeler
                </a>
            </li>
            <li>
                <a href="#" class="nav-link">
                    <i class="bi bi-tags me-2"></i> Üyelik Paketleri
                </a>
            </li>
        </ul>
        <hr class="border-secondary opacity-25">
        <div class="mt-auto">
            <a href="/" class="btn btn-outline-secondary w-100 text-start">
                <i class="bi bi-box-arrow-left me-2"></i> Siteye Dön
            </a>
        </div>
    </div>

    <div class="admin-content p-4 p-md-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>