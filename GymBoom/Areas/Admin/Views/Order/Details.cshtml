@model GymBoom.Models.Order
@{
    ViewData["Title"] = "Sipariş Detayı";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-light">📄 Sipariş Detayı: <span class="text-info">@Model.OrderNumber</span></h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i> Siparişlere Dön
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card gym-card h-100">
                <div class="card-header bg-dark border-bottom border-secondary">
                    <h5 class="text-light mb-0"><i class="bi bi-person-lines-fill me-2"></i> Müşteri Bilgileri</h5>
                </div>
                <div class="card-body">
                    <p class="text-light mb-1"><span class="text-secondary">Müşteri ID:</span> @Model.UserId</p>
                    <p class="text-light mb-1"><span class="text-secondary">Tarih:</span> @Model.CreatedDate.ToString("dd MMMM yyyy HH:mm")</p>
                    <p class="text-light mb-3">
                        <span class="text-secondary">Durum:</span> 
                        <span class="badge @(Model.Status == "Onaylandı" ? "bg-success" : (Model.Status == "İptal" ? "bg-danger" : "bg-warning"))">@Model.Status</span>
                    </p>
                    <hr class="border-secondary opacity-25">
                    <h6 class="text-info mt-3">Teslimat Adresi</h6>
                    <p class="text-light mb-1"><strong>Şehir:</strong> @Model.City</p>
                    <p class="text-light"><strong>Adres:</strong> @Model.Address</p>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card gym-card h-100">
                <div class="card-header bg-dark border-bottom border-secondary">
                    <h5 class="text-light mb-0"><i class="bi bi-box-seam me-2"></i> Sipariş İçeriği</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-dark table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th class="text-center">Birim Fiyat</th>
                                <th class="text-center">Adet</th>
                                <th class="text-end">Ara Toplam</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderItems != null && Model.OrderItems.Any())
                            {
                                foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            @(item.Product != null ? item.Product.Name : "Ürün Silinmiş (ID: " + item.ProductId + ")")
                                        </td>
                                        <td class="align-middle text-center">@item.UnitPrice.ToString("C")</td>
                                        <td class="align-middle text-center">@item.Quantity</td>
                                        <td class="align-middle text-end fw-semibold">
                                            @((item.UnitPrice * item.Quantity).ToString("C"))
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">Bu siparişte ürün bulunamadı.</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="border-top border-secondary">
                            <tr>
                                <td colspan="3" class="text-end fw-bold text-light fs-5 py-3">Genel Toplam:</td>
                                <td class="text-end fw-bold text-success fs-5 py-3">@Model.TotalAmount.ToString("C")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>