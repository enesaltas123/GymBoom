@model IEnumerable<GymBoom.Models.User>
@{
    ViewData["Title"] = "Üye Yönetimi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-light">👥 Üye Yönetimi</h2>
    </div>

    <!-- Hata Mesajı Alanı (Yeni Eklendi) -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Başarı Mesajı Alanı -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card gym-card">
        <div class="card-body p-0">
            <table class="table table-dark table-hover mb-0">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>E-posta</th>
                        <th>Rol</th>
                        <th>Salon Üyeliği</th>
                        <th>Hesap Durumu</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle fw-bold">@item.FullName</td>
                                <td class="align-middle">@item.Email</td>
                                <td class="align-middle">
                                    <span class="badge @(item.Role == "Admin" ? "bg-danger" : "bg-info text-dark")">@item.Role</span>
                                </td>
                                <td class="align-middle">
                                    @if (item.MembershipEndDate.HasValue && item.MembershipEndDate > DateTime.UtcNow)
                                    {
                                        <span class="text-success small fw-semibold">
                                            <i class="bi bi-check-circle-fill me-1"></i> 
                                            Bitiş: @item.MembershipEndDate.Value.ToString("dd.MM.yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small">
                                            <i class="bi bi-x-circle me-1"></i> Aktif Paket Yok
                                        </span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                        @(item.IsActive ? "Aktif" : "Pasif")
                                    </span>
                                </td>
                                <td class="text-end align-middle">
                                    @if (item.Role == "Admin")
                                    {
                                        <button class="btn btn-sm btn-secondary" disabled style="cursor: not-allowed;">
                                            <i class="bi bi-shield-lock me-1"></i>Koruma Altında
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline" 
                                              onsubmit="return confirm('@(item.IsActive ? "Bu üyeyi pasife almak istediğinize emin misiniz?" : "Bu üyeyi tekrar aktifleştirmek istediğinize emin misiniz?")');">
                                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                                @(item.IsActive ? "Pasife Al" : "Aktifleştir")
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Sistemde henüz kayıtlı üye bulunmuyor.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>