@{
    ViewData["Title"] = "Gösterge Paneli";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white fw-bold">Gösterge Paneli</h2>
    <span class="text-secondary">Tarih: @DateTime.Now.ToString("dd MMMM yyyy")</span>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card bg-dark border-secondary border-opacity-25 shadow-sm">
            <div class="card-body p-4">
                <h6 class="text-secondary fw-bold text-uppercase mb-3">Aktif Üyeler</h6>
                <h2 class="text-white mb-0">@ViewBag.ActiveUserCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-dark border-secondary border-opacity-25 shadow-sm">
            <div class="card-body p-4">
                <h6 class="text-secondary fw-bold text-uppercase mb-3">Verilen Sipariş Sayısı</h6>
                <h2 class="text-warning mb-0">@ViewBag.PendingOrderCount</h2>
            </div>
        </div>
    </div>
</div>