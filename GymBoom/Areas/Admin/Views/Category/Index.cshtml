@model IEnumerable<GymBoom.Models.Category>
@{
    ViewData["Title"] = "API - Kategorileri Yönet";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white">API'den Çekilen Kategoriler</h2>
        <a href="/Admin/Category/Create" class="btn btn-danger fw-bold shadow-sm">
            + Yeni Kategori Ekle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success fw-bold">✓ @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger fw-bold">❌ @TempData["ErrorMessage"]</div>
    }

    <div class="table-responsive bg-dark rounded-3 shadow p-3" style="border: 1px solid #30363d;">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr class="text-secondary" style="border-bottom: 2px solid #495057;">
                    <th scope="col">#ID</th>
                    <th scope="col">Kategori Adı</th>
                    <th scope="col">Açıklama</th>
                    <th scope="col">Durum</th>
                    <th scope="col" class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var category in Model)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">@category.Id</td>
                            <td class="fw-semibold text-white">@category.Name</td>
                            <td class="text-light opacity-75">@(string.IsNullOrEmpty(category.Description) ? "-" : category.Description)</td>
                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-area="Admin" asp-controller="Category" asp-action="ToggleStatus" asp-route-id="@category.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(category.IsActive ? "btn-outline-warning" : "btn-outline-success") fw-bold shadow-sm me-1">
                                        @(category.IsActive ? "⏸ Pasif Yap" : "▶️ Aktif Yap")
                                    </button>
                                </form>

                                <form asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kategoriyi kalıcı olarak silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger fw-bold shadow-sm">
                                        🗑️ Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-secondary">
                            <span class="fs-1 d-block mb-2">📡</span>
                            API'den henüz bir veri gelmedi veya kategori bulunmuyor.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>