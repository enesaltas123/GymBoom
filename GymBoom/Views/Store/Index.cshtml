@model IEnumerable<GymBoom.Models.Product>
@{
    ViewData["Title"] = "GymBoom Store - Mağaza";
    var categories = ViewBag.Categories as List<GymBoom.Models.Category> ?? new();
}

<div class="text-center py-4 mb-4">
    <span class="badge bg-danger px-3 py-2 text-uppercase fw-bold mb-2 shadow-sm">
        GYMBOOM OFFICIAL STORE
    </span>
    <h1 class="display-5 fw-bold text-white">Sporcu Besinleri & Antrenman Ekipmanları</h1>
    <p class="text-secondary col-md-7 mx-auto mt-2 fs-5">
        %100 orijinal takviyeler, olimpik barlar, dambıllar ve antrenman performansını zirveye taşıyacak ekipmanlar.
    </p>
</div>

<div class="container mb-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-25 border border-success text-white mb-4 rounded-3 shadow-sm" role="alert">
            ✓ @TempData["SuccessMessage"]
            <a href="/Cart" class="text-white fw-bold text-decoration-underline ms-2">Sepete Git</a>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-center flex-wrap gap-2 mb-5">
        <a href="/Store/Index" 
           class="btn @(ViewBag.CurrentCategory == null ? "btn-danger" : "btn-outline-secondary text-light border-opacity-50") px-4 py-2 rounded-pill fw-semibold shadow-sm">
            Tümü
        </a>
        
        @foreach (var cat in categories)
        {
            <a href="/Store/Index?categoryId=@cat.Id" 
               class="btn @(ViewBag.CurrentCategory == cat.Id ? "btn-danger" : "btn-outline-secondary text-light border-opacity-50") px-4 py-2 rounded-pill fw-semibold shadow-sm">
                @cat.Name
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="p-5 rounded-4 shadow-sm mx-auto" style="background-color: #161b22; border: 1px dashed #30363d; max-width: 600px;">
                <span class="display-1 mb-3 d-block opacity-75">📦</span>
                <h3 class="text-white fw-bold mb-3">Bu Kategorideki Stokları Tükettik!</h3>
                <p class="text-secondary fs-6 mb-0">
                    Görünüşe göre sporcularımız bu kategorideki tüm ekipmanları çoktan kaptı. Yeni ürünler yolda! <br/><br/>
                    Antrenmanını yarım bırakma, mağazadaki diğer efsane ürünlere göz atmaya devam et.
                </p>
                <a href="/Store/Index" class="btn btn-outline-danger mt-4 px-4 py-2 rounded-pill fw-semibold shadow-sm">
                    Tüm Ürünlere Dön
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                string imageName = "default.jpg";
                switch (product.Id)
                {
                    case 1: imageName = "Adjustable_dumbbells.jpg"; break;
                    case 2: imageName = "Olympic_barbell.jpg"; break;
                    case 3: imageName = "Resistance _bands.jpg"; break;
                    case 4: imageName = "Yoga_mat.jpg"; break;
                    case 5: imageName = "Weightlifting_belt_leather.jpg"; break;
                    case 6: imageName = "Gym_gloves.jpg"; break;
                    case 7: imageName = "Metal_protein_shaker.jpg"; break;
                    case 8: imageName = "Protein_powder_chocolate.jpg"; break;
                    case 9: imageName = "Creatine_supplement_powder.jpg"; break;
                    case 10: imageName = "Pre_workout_powder.jpg"; break;
                }

                <div class="col-lg-4 col-md-6">
                    <div class="card gym-card rounded-4 h-100 p-3 d-flex flex-column justify-content-between shadow-sm">
                        
                        <div class="rounded-3 text-center mb-3 position-relative" style="background-color: #21262d; border: 1px solid #30363d; height: 220px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                            
                            <img src="~/StoreImages/@imageName" alt="@product.Name" style="width: 100%; height: 100%; object-fit: contain;" class="p-2" />

                            <span class="position-absolute top-0 start-0 badge bg-dark text-secondary m-2 border border-secondary border-opacity-25">
                                @(product.Category?.Name ?? "Ekipman")
                            </span>

                            @if (product.Stock <= 15)
                            {
                                <span class="position-absolute top-0 end-0 badge bg-warning text-dark m-2 fw-bold">
                                    Son @product.Stock Adet
                                </span>
                            }
                        </div>
                        
                        <div class="mb-3">
                            <h5 class="fw-bold text-white mb-2">@product.Name</h5>
                            <p class="text-secondary small mb-0" style="min-height: 40px;">
                                @product.Description
                            </p>
                        </div>

                        <div class="pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center mt-auto">
                            <div>
                                <div class="fs-4 fw-bold text-white">@product.Price.ToString("N2") ₺</div>
                                <small class="text-success fw-semibold">✓ Stokta Mevcut</small>
                            </div>
                            
                            <form action="/Cart/AddToCart" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-danger px-3 py-2 fw-semibold rounded-3 shadow-sm">
                                    Sepete Ekle
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>