@model IEnumerable<GymBoom.Models.Product>
@{
    ViewData["Title"] = "GymBoom Store - Mağaza";
    var categories = ViewBag.Categories as List<GymBoom.Models.Category> ?? new();
}

<div class="position-fixed bottom-0 end-0 p-4" style="z-index: 1050;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-25 border border-success text-white shadow-lg rounded-3" role="alert" style="min-width: 300px; backdrop-filter: blur(10px);">
            <div class="d-flex align-items-center mb-2">
                <span class="fs-5 me-2">✅</span> 
                <strong class="me-auto">Başarılı!</strong>
            </div>
            <div>@TempData["SuccessMessage"]</div>
            <div class="mt-3 pt-2 border-top border-success border-opacity-25">
                <a href="/Cart" class="btn btn-sm btn-success fw-bold w-100 text-dark">Sepete Git 🛒</a>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bg-danger bg-opacity-25 border border-danger text-white shadow-lg rounded-3" role="alert" style="min-width: 300px; backdrop-filter: blur(10px);">
            <div class="d-flex align-items-center mb-2">
                <span class="fs-5 me-2">⚠️</span> 
                <strong class="me-auto">Uyarı</strong>
            </div>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

<div class="text-center py-4 mb-4">
    <span class="badge bg-danger px-3 py-2 text-uppercase fw-bold mb-2 shadow-sm">
        GYMBOOM OFFICIAL STORE
    </span>
    <h1 class="display-5 fw-bold text-white">Sporcu Besinleri & Antrenman Ekipmanları</h1>
    <p class="text-secondary col-md-7 mx-auto mt-2 fs-5">
        %100 orijinal takviyeler, olimpik barlar, dambıllar ve antrenman performansını zirveye taşıyacak ekipmanlar.
    </p>
</div>

<div class="container mb-5">
    <div class="row g-4">
        
        <div class="col-lg-3">
            <div class="card gym-card p-4 rounded-4 shadow-sm sticky-top" style="background-color: #161b22; border: 1px solid #30363d; top: 20px;">
                <h5 class="fw-bold text-white mb-4 d-flex align-items-center justify-content-between">
                    Filtreler
                    <a href="/Store/Index" class="text-secondary small text-decoration-none fw-normal" title="Filtreleri Temizle">Temizle ↺</a>
                </h5>

                <form asp-controller="Store" asp-action="Index" method="get">
                    
                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-bold mb-2">Ürün Ara</label>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" placeholder="Örn: Protein, Dambıl...">
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-bold mb-2">Kategoriler</label>
                        <div class="d-flex flex-column gap-2">
                            <label class="form-check-label text-light" style="cursor: pointer;">
                                <input type="radio" name="categoryId" value="" class="form-check-input me-2 bg-dark border-secondary" @(ViewBag.CurrentCategory == null ? "checked" : "") onchange="this.form.submit()">
                                Tümü
                            </label>

                            @foreach (var cat in categories)
                            {
                                <label class="form-check-label text-light" style="cursor: pointer;">
                                    <input type="radio" name="categoryId" value="@cat.Id" class="form-check-input me-2 bg-dark border-secondary" @(ViewBag.CurrentCategory == cat.Id ? "checked" : "") onchange="this.form.submit()">
                                    @cat.Name
                                </label>
                            }
                        </div>
                    </div>

                    <div class="mb-4 border-top border-secondary border-opacity-25 pt-4">
                        <label class="form-label text-secondary small fw-bold mb-2">Fiyat Aralığı (₺)</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" name="minPrice" value="@ViewBag.CurrentMinPrice" class="form-control bg-dark text-white border-secondary border-opacity-50 form-control-sm py-2" placeholder="Min" step="1">
                            </div>
                            <div class="col-6">
                                <input type="number" name="maxPrice" value="@ViewBag.CurrentMaxPrice" class="form-control bg-dark text-white border-secondary border-opacity-50 form-control-sm py-2" placeholder="Max" step="1">
                            </div>
                        </div>
                    </div>

                    <div class="mb-4 border-top border-secondary border-opacity-25 pt-4">
                        <label class="form-label text-secondary small fw-bold mb-2">Sıralama</label>
                        <select name="sortOrder" class="form-select bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" onchange="this.form.submit()">
                            <option value="">En Yeniler</option>
                            <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc" ? "selected" : null)">Fiyata Göre Artan</option>
                            <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc" ? "selected" : null)">Fiyata Göre Azalan</option>
                            <option value="name_asc" selected="@(ViewBag.CurrentSort == "name_asc" ? "selected" : null)">İsim (A-Z)</option>
                            <option value="name_desc" selected="@(ViewBag.CurrentSort == "name_desc" ? "selected" : null)">İsim (Z-A)</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 py-2 fw-bold rounded-3 shadow-sm">
                        Sonuçları Göster
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-9">
            
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="p-5 rounded-4 shadow-sm mx-auto" style="background-color: #161b22; border: 1px dashed #30363d;">
                        <span class="display-1 mb-3 d-block opacity-75">📦</span>
                        <h3 class="text-white fw-bold mb-3">Aradığınız Kriterlere Uygun Ürün Bulunamadı!</h3>
                        <p class="text-secondary fs-6 mb-0">
                            Filtre seçeneklerinizi değiştirerek tekrar aramayı deneyebilirsiniz.
                        </p>
                        <a href="/Store/Index" class="btn btn-outline-danger mt-4 px-4 py-2 rounded-pill fw-semibold shadow-sm">
                            Filtreleri Temizle
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-secondary small fw-semibold">
                        Toplam <span class="text-white">@Model.Count()</span> ürün listeleniyor.
                    </span>
                </div>

                <div class="row g-4">
                    @foreach (var product in Model)
                    {
                        string imgPath = string.IsNullOrEmpty(product.ImageUrl) 
                            ? "/StoreImages/default.jpg" 
                            : (product.ImageUrl.StartsWith("/") ? product.ImageUrl : $"/StoreImages/{product.ImageUrl}");

                        <div class="col-xl-4 col-md-6">
                            <div class="card gym-card rounded-4 h-100 p-3 d-flex flex-column justify-content-between shadow-sm" style="background-color: #161b22; border: 1px solid #30363d;">
                                
                                <div class="rounded-3 text-center mb-3 position-relative" style="background-color: #21262d; height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                    
                                    <img src="@imgPath" alt="@product.Name" style="width: 100%; height: 100%; object-fit: contain;" class="p-2" onerror="this.onerror=null; this.src='/StoreImages/default.jpg';" />

                                    <span class="position-absolute top-0 start-0 badge bg-dark text-secondary m-2 border border-secondary border-opacity-25">
                                        @(product.Category?.Name ?? "Ekipman")
                                    </span>

                                    @if (product.Stock <= 0)
                                    {
                                        <span class="position-absolute top-0 end-0 badge bg-danger text-white m-2 fw-bold shadow-sm">
                                            Tükendi
                                        </span>
                                    }
                                    else if (product.Stock <= 15)
                                    {
                                        <span class="position-absolute top-0 end-0 badge bg-warning text-dark m-2 fw-bold">
                                            Son @product.Stock
                                        </span>
                                    }
                                </div>
                                
                                <div class="mb-3">
                                    <h5 class="fw-bold text-white mb-2 fs-6">@product.Name</h5>
                                    <p class="text-secondary small mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @product.Description
                                    </p>
                                </div>

                                <div class="pt-3 border-top border-secondary border-opacity-25 mt-auto">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fs-5 fw-bold text-white">@product.Price.ToString("N2") ₺</div>
                                        
                                        @if (product.Stock > 0)
                                        {
                                            <small class="text-success fw-semibold" style="font-size: 0.7rem;">✓ Stokta</small>
                                        }
                                        else
                                        {
                                            <small class="text-danger fw-semibold" style="font-size: 0.7rem;">✗ Tükendi</small>
                                        }
                                    </div>
                                    
                                    @if (product.Stock > 0)
                                    {
                                        <form action="/Cart/AddToCart" method="post" class="m-0 w-100">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold rounded-3 shadow-sm">
                                                Sepete Ekle
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-secondary text-secondary w-100 py-2 fw-semibold rounded-3 shadow-sm" disabled>
                                            Stokta Yok
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var scrollpos = localStorage.getItem('gymboom_scrollpos');
        if (scrollpos) {
            window.scrollTo({ top: parseInt(scrollpos), behavior: 'instant' });
            localStorage.removeItem('gymboom_scrollpos'); 
        }
    });

    window.addEventListener("beforeunload", function() {
        localStorage.setItem('gymboom_scrollpos', window.scrollY);
    });
</script>