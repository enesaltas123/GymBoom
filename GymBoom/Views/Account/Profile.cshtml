@model GymBoom.Models.ViewModels.Account.ProfileViewModel
@{
    ViewData["Title"] = "Profilim - GymBoom";
}

<div class="container py-5">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-25 border border-success text-white mb-4 rounded-3 shadow-sm" role="alert">
            <i class="fs-5 me-2">🎉</i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card gym-card h-100 rounded-4 shadow-sm border-secondary border-opacity-25 p-4" style="background-color: #161b22;">
                <div class="text-center mb-4">
                    <div class="bg-dark text-secondary d-inline-flex align-items-center justify-content-center rounded-circle border border-secondary border-opacity-25 mb-3" style="width: 100px; height: 100px; font-size: 2.5rem;">
                        👤
                    </div>
                    <h3 class="fw-bold text-white mb-1">@Model.AppUser.FullName</h3>
                    <p class="text-secondary mb-0">@Model.AppUser.Email</p>
                </div>
                
                <hr class="border-secondary opacity-25">
                
                <ul class="list-unstyled text-secondary mb-0">
                    <li class="mb-3 d-flex justify-content-between">
                        <span>Hesap Rolü:</span>
                        <span class="text-white fw-semibold">@(Model.AppUser.Role == "Admin" ? "Yönetici" : "Üye")</span>
                    </li>
                    <li class="d-flex justify-content-between">
                        <span>Katılım Tarihi:</span>
                        <span class="text-white fw-semibold">@Model.AppUser.CreatedDate.ToString("dd MMM yyyy")</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card gym-card rounded-4 shadow-sm border-secondary border-opacity-25 p-4 mb-4" style="background-color: #161b22;">
                <h4 class="fw-bold text-white mb-4">Üyelik Durumu</h4>
                
                @if (Model.AppUser.ActiveGymPlanId != null && Model.AppUser.ActiveGymPlan != null && Model.AppUser.MembershipEndDate.HasValue && Model.AppUser.MembershipEndDate.Value > DateTime.UtcNow)
                {
                    var remainingDays = (Model.AppUser.MembershipEndDate.Value - DateTime.UtcNow).Days;
                    
                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between p-4 rounded-3" style="background-color: #21262d; border: 1px solid #30363d;">
                        <div class="mb-3 mb-md-0">
                            <span class="badge bg-success mb-2 px-2 py-1">Aktif Üyelik</span>
                            <h3 class="text-white fw-bold mb-1">@Model.AppUser.ActiveGymPlan.Title</h3>
                            <p class="text-secondary mb-0">Bitiş Tarihi: <span class="text-white fw-semibold">@Model.AppUser.MembershipEndDate.Value.ToString("dd MMMM yyyy")</span></p>
                        </div>
                        
                        <div class="text-md-end text-center p-3 rounded-3 bg-dark border border-secondary border-opacity-25">
                            <div class="display-5 fw-black text-white">@remainingDays</div>
                            <div class="text-secondary small fw-bold text-uppercase tracking-wide">Gün Kaldı</div>
                        </div>
                    </div>
                    <div class="mt-4 text-end">
                        <a href="/GymPlan" class="btn btn-outline-danger rounded-3 fw-bold">Paketi Uzat / Yenile</a>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 rounded-3" style="background-color: #21262d; border: 1px solid #30363d;">
                        <span class="display-1 text-secondary opacity-50 mb-3 d-block">📉</span>
                        <h5 class="text-white fw-bold">Aktif Bir Salon Üyeliğiniz Bulunmuyor</h5>
                        <p class="text-secondary mb-4">Hedeflerinize ulaşmak için hemen bir plan seçin ve antrenmanlara başlayın.</p>
                        <a href="/GymPlan" class="btn btn-danger px-4 py-2 rounded-3 fw-bold">Paketleri İncele</a>
                    </div>
                }
            </div>
            
            <div class="card gym-card rounded-4 shadow-sm border-secondary border-opacity-25 p-4" style="background-color: #161b22;">
                <h4 class="fw-bold text-white mb-3">Son Siparişlerim (Mağaza)</h4>
                
                @if (Model.PastOrders != null && Model.PastOrders.Any())
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-dark table-borderless align-middle mb-0">
                            <thead class="border-bottom border-secondary border-opacity-25">
                                <tr>
                                    <th class="text-secondary pb-3">Sipariş No</th>
                                    <th class="text-secondary pb-3">Tarih</th>
                                    <th class="text-secondary pb-3">Tutar</th>
                                    <th class="text-secondary pb-3 text-end">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.PastOrders)
                                {
                                    <tr class="border-bottom border-secondary border-opacity-10">
                                        <td class="text-white py-3 fw-semibold">@order.OrderNumber</td>
                                        <td class="text-secondary py-3">@order.CreatedDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-white py-3 fw-bold">@order.TotalAmount.ToString("C")</td>
                                        <td class="py-3 text-end">
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2 py-1">@order.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-secondary">
                        Henüz mağazadan ürün siparişi vermediniz.
                    </div>
                }
            </div>
        </div>
    </div>
</div>