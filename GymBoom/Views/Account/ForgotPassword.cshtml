@model GymBoom.Models.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum - GymBoom";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card gym-card p-4 p-md-5 rounded-4 shadow-lg">
                <div class="text-center mb-4">
                    <span class="badge bg-danger px-3 py-2 text-uppercase fw-bold mb-2">ŞİFRE SIFIRLAMA</span>
                    <h2 class="fw-bold text-white">Şifremi Unuttum</h2>
                    <p class="text-secondary small">Kayıtlı e-posta adresinizi girin. Size giriş yapabilmeniz için yeni bir geçici şifre göndereceğiz.</p>
                </div>

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label text-light small fw-semibold"></label>
                        <input asp-for="Email" class="form-control bg-dark text-white border-secondary border-opacity-50 py-2 rounded-3" placeholder="ornek@email.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 py-2 fw-bold rounded-3 shadow">
                        Yeni Şifre Gönder
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-action="Login" class="text-secondary small text-decoration-none hover-white">← Giriş Sayfasına Dön</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}