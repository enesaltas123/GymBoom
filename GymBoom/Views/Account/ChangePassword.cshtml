@model GymBoom.Models.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir - GymBoom";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card gym-card p-4 p-md-5 rounded-4 shadow-lg">
                <div class="text-center mb-4">
                    <span class="badge bg-warning text-dark px-3 py-2 text-uppercase fw-bold mb-2">GÜVENLİK AYARLARI</span>
                    <h2 class="fw-bold text-white">Şifre Değiştir</h2>
                    <p class="text-secondary small">Hesabınızın güvenliği için yeni bir şifre belirleyin.</p>
                </div>

                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label text-light small fw-semibold"></label>
                        <input asp-for="CurrentPassword" class="form-control bg-dark text-white border-secondary border-opacity-50 py-2 rounded-3" placeholder="Mevcut şifreniz" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label text-light small fw-semibold"></label>
                        <input asp-for="NewPassword" class="form-control bg-dark text-white border-secondary border-opacity-50 py-2 rounded-3" placeholder="Yeni şifreniz" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label text-light small fw-semibold"></label>
                        <input asp-for="ConfirmNewPassword" class="form-control bg-dark text-white border-secondary border-opacity-50 py-2 rounded-3" placeholder="Yeni şifrenizi tekrar girin" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 py-2 fw-bold rounded-3 shadow text-dark">
                        Şifreyi Güncelle
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-action="Profile" class="text-secondary small text-decoration-none hover-white">← Profile Dön</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}