@model IEnumerable<GymBoom.Models.GymPlan>
@{
    ViewData["Title"] = "Üyelik Paketleri - GymBoom";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-danger px-3 py-2 text-uppercase fw-bold mb-2 shadow-sm">
            GYMBOOM CLUB
        </span>
        <h1 class="display-5 fw-bold text-white">Sana En Uygun Üyeliği Seç</h1>
        <p class="text-secondary col-md-6 mx-auto mt-2 fs-5">
            Hedeflerine ulaşmak için ilk adımı at. İster aylık başla, ister yıllık planla avantajı yakala.
        </p>
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (var plan in Model)
        {
            // Popüler plan kontrolü
            bool isPopular = plan.Price > 500 && plan.Price < 3000;
            
            <div class="col-lg-4 col-md-6">
                <div class="card gym-card h-100 rounded-4 overflow-hidden shadow-sm d-flex flex-column @(isPopular ? "border-danger border-2" : "border-secondary border-opacity-25")" style="background-color: #161b22;">
                    
                    <!-- Popüler Şeridi -->
                    @if (isPopular)
                    {
                        <div class="bg-danger text-white text-center py-2 fw-bold text-uppercase small tracking-wide shadow-sm">
                            ★ En Çok Tercih Edilen ★
                        </div>
                    }

                    <!-- Kart Üst Kısmı (Başlık ve Fiyat) -->
                    <div class="p-4 text-center border-bottom border-secondary border-opacity-25" style="background-color: #21262d;">
                        <h3 class="fw-bold text-white mb-2">@plan.Title</h3>
                        <p class="text-secondary small mb-3" style="min-height: 40px;">@plan.Description</p>
                        
                        <div class="display-4 fw-black text-white mb-0">
                            @plan.Price.ToString("N0")<span class="fs-4 text-secondary">₺</span>
                        </div>
                        <div class="text-secondary small fw-semibold mt-1">/ @plan.DurationInMonths Ay</div>
                    </div>

                    <!-- Kart Gövdesi (Özellikler) -->
                    <div class="card-body p-4 d-flex flex-column flex-grow-1">
                        <ul class="list-unstyled text-secondary mb-4 mx-auto w-100" style="max-width: 250px;">
                            <li class="mb-3 d-flex align-items-center gap-3">
                                <span class="text-danger fw-bold fs-5">✓</span>
                                <span class="text-light">Sınırsız Salon Kullanımı</span>
                            </li>
                            <li class="mb-3 d-flex align-items-center gap-3">
                                <span class="text-danger fw-bold fs-5">✓</span>
                                <span class="text-light">Grup Derslerine Katılım</span>
                            </li>
                            <li class="mb-3 d-flex align-items-center gap-3">
                                <span class="text-danger fw-bold fs-5">✓</span>
                                <span class="text-light">Duş ve Soyunma Odası</span>
                            </li>
                            
                            <!-- Premium Özellikler Kontrolü -->
                            @if (plan.Price >= 1000)
                            {
                                <li class="mb-3 d-flex align-items-center gap-3">
                                    <span class="text-warning fw-bold fs-5">★</span>
                                    <span class="text-white fw-bold">Ücretsiz 1 PT Dersi</span>
                                </li>
                                <li class="mb-3 d-flex align-items-center gap-3">
                                    <span class="text-warning fw-bold fs-5">★</span>
                                    <span class="text-white fw-bold">Detaylı Vücut Analizi</span>
                                </li>
                            }
                            else
                            {
                                <li class="mb-3 d-flex align-items-center gap-3 opacity-50">
                                    <span class="text-secondary fw-bold fs-5">✕</span>
                                    <span class="text-decoration-line-through">Ücretsiz 1 PT Dersi</span>
                                </li>
                                <li class="mb-3 d-flex align-items-center gap-3 opacity-50">
                                    <span class="text-secondary fw-bold fs-5">✕</span>
                                    <span class="text-decoration-line-through">Detaylı Vücut Analizi</span>
                                </li>
                            }
                        </ul>

                        <!-- Buton Alanı -->
                        <div class="mt-auto pt-3 border-top border-secondary border-opacity-25">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <button type="button" class="btn btn-danger w-100 py-3 fw-bold rounded-3 shadow-sm text-uppercase">
                                    Planı Seç
                                </button>
                            }
                            else
                            {
                                <a href="/Account/Login?returnUrl=/GymPlan" class="btn btn-outline-light w-100 py-3 fw-bold rounded-3 text-uppercase">
                                    Giriş Yap ve Seç
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>