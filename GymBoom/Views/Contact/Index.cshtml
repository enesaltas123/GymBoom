@model GymBoom.Models.ContactViewModel

<div class="container mt-5 text-white">
    <h2>Bize Ulaşın</h2>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">@ViewBag.Message</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Index" method="post" class="mt-4">
        <div class="mb-3">
            <label class="form-label">Adınız</label>
            <input asp-for="Name" class="form-control bg-dark text-white border-secondary" required />
        </div>
        <div class="mb-3">
            <label class="form-label">E-Posta Adresiniz</label>
            <input asp-for="Email" type="email" class="form-control bg-dark text-white border-secondary" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Mesajınız</label>
            <textarea asp-for="Message" class="form-control bg-dark text-white border-secondary" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn-danger w-100">Mesajı Gönder</button>
    </form>
</div>